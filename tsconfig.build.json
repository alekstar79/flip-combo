{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/main.ts",
    "examples/**",
    "__tests__/**",
    "vite.config.ts",
    "vite.lib.config.ts"
  ]
}
